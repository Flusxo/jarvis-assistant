<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#02070D">
    <com.jarvis.assistant.JarvisCoreView android:id="@+id/jarvisCore" android:layout_width="match_parent" android:layout_height="match_parent" />
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#6602070D" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="22dp" android:paddingBottom="30dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical">
                <ImageButton android:id="@+id/closeButton" android:layout_width="46dp" android:layout_height="46dp" android:background="@android:color/transparent" android:src="@android:drawable/ic_menu_close_clear_cancel" android:contentDescription="Close" android:padding="10dp" android:tint="#C9F4FF" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="JARVIS ACCOUNT" android:textColor="#F0FCFF" android:textSize="17sp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.12" />
                <Space android:layout_width="46dp" android:layout_height="1dp" />
            </LinearLayout>
            <ImageView android:id="@+id/avatar" android:layout_width="112dp" android:layout_height="112dp" android:layout_gravity="center_horizontal" android:layout_marginTop="34dp" android:background="@drawable/account_avatar_bg" android:padding="3dp" android:scaleType="centerCrop" android:contentDescription="Google profile picture" />
            <TextView android:id="@+id/nameText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="Google user" android:textColor="#F4FCFF" android:textSize="22sp" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/emailText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="email@gmail.com" android:textColor="#78DDF4" android:textSize="13sp" />
            <TextView android:id="@+id/accountStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:text="ACCOUNT ACTIVE" android:textColor="#69E8FF" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.15" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="30dp" android:background="#335C8290" />
            <Button android:id="@+id/addAccountButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="22dp" android:text="＋  Add Google account" android:textAllCaps="false" android:textColor="#DDF8FF" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:background="@drawable/bg_input" />
            <Button android:id="@+id/switchAccountButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:text="⇄  Switch account" android:textAllCaps="false" android:textColor="#DDF8FF" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:background="@drawable/bg_input" />
            <Button android:id="@+id/signOutButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:text="↪  Sign out" android:textAllCaps="false" android:textColor="#DDF8FF" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:background="@drawable/bg_input" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
