<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07090D">

    <!-- Living JARVIS environment. The custom view draws the animated core, grid, glow and particles. -->
    <com.jarvis.assistant.JarvisCoreView
        android:id="@+id/jarvisCore"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Soft dark veil keeps text readable while preserving the animated environment underneath. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#6605090F" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <!-- TOP HUD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/historyButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_recent_history"
                android:contentDescription="Chat history"
                android:padding="9dp"
                app:tint="#D9E2EA" />

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/jarvis_logo"
                android:contentDescription="JARVIS" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/conversationTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JARVIS"
                    android:textColor="#F2F6FA"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SYSTEM ONLINE • AUDIO READY • AI READY"
                    android:textColor="#91A1AE"
                    android:textSize="8sp"
                    android:layout_marginTop="1dp"
                    android:maxLines="1" />
            </LinearLayout>

            <AccountButtonView
                android:id="@+id/accountButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_myplaces"
                android:padding="8dp"
                app:tint="#DDE7EF" />
        </LinearLayout>

        <!-- CORE / HUD AREA -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.78"
            android:minHeight="300dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FLOATING JARVIS • OFF"
                    android:textColor="#768590"
                    android:textSize="8sp"
                    android:letterSpacing="0.18"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CORE ONLINE     AUDIO READY     AI READY     VISION READY"
                    android:textColor="#758792"
                    android:textSize="7sp"
                    android:letterSpacing="0.12"
                    android:layout_marginTop="120dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JARVIS"
                    android:textColor="#F1F6FA"
                    android:textSize="24sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.12"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SYSTEM READY"
                    android:textColor="#9AAAB5"
                    android:textSize="8sp"
                    android:letterSpacing="0.24" />
            </LinearLayout>

            <!-- small live HUD markers -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:text="CORE ONLINE"
                android:textColor="#728691"
                android:textSize="7sp"
                android:letterSpacing="0.15"
                android:rotation="0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:text="VISION READY"
                android:textColor="#728691"
                android:textSize="7sp"
                android:letterSpacing="0.15" />
        </FrameLayout>

        <!-- QUICK ACTIONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp">

            <TextView android:id="@+id/quickMic" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:gravity="center" android:text="MIC" android:textColor="#C9D5DD" android:textSize="8sp" android:background="#321C252B" />
            <TextView android:id="@+id/quickVision" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:layout_marginStart="2dp" android:gravity="center" android:text="VISION" android:textColor="#C9D5DD" android:textSize="8sp" android:background="#321C252B" />
            <TextView android:id="@+id/quickMusic" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:layout_marginStart="2dp" android:gravity="center" android:text="MUSIC" android:textColor="#C9D5DD" android:textSize="8sp" android:background="#321C252B" />
            <TextView android:id="@+id/quickTimer" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:layout_marginStart="2dp" android:gravity="center" android:text="TIMER" android:textColor="#C9D5DD" android:textSize="8sp" android:background="#321C252B" />
            <TextView android:id="@+id/quickNote" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:layout_marginStart="2dp" android:gravity="center" android:text="NOTE" android:textColor="#C9D5DD" android:textSize="8sp" android:background="#321C252B" />
            <TextView android:id="@+id/quickMap" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:layout_marginStart="2dp" android:gravity="center" android:text="MAP" android:textColor="#C9D5DD" android:textSize="8sp" android:background="#321C252B" />
        </LinearLayout>

        <!-- CHAT -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.92">

            <LinearLayout
                android:id="@+id/emptyStateContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="What's on your mind?"
                    android:textColor="#E8EEF2"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:layout_marginBottom="14dp" />

                <TextView android:id="@+id/suggestion1" android:layout_width="230dp" android:layout_height="38dp" android:text="Explain something to me" android:textColor="#BFCBD3" android:textSize="11sp" android:gravity="center" android:background="@drawable/bg_input" android:layout_marginBottom="7dp" android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/suggestion2" android:layout_width="230dp" android:layout_height="38dp" android:text="Give me some ideas" android:textColor="#BFCBD3" android:textSize="11sp" android:gravity="center" android:background="@drawable/bg_input" android:layout_marginBottom="7dp" android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/suggestion3" android:layout_width="230dp" android:layout_height="38dp" android:text="Tell me something interesting" android:textColor="#BFCBD3" android:textSize="11sp" android:gravity="center" android:background="@drawable/bg_input" android:clickable="true" android:focusable="true" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/chatScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/chatContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp" />
            </ScrollView>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/thinkingDots"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="7dp"
            android:visibility="gone">
            <View android:id="@+id/dot1" android:layout_width="5dp" android:layout_height="5dp" android:layout_marginEnd="4dp" android:background="@drawable/dot_shape" />
            <View android:id="@+id/dot2" android:layout_width="5dp" android:layout_height="5dp" android:layout_marginEnd="4dp" android:background="@drawable/dot_shape" />
            <View android:id="@+id/dot3" android:layout_width="5dp" android:layout_height="5dp" android:background="@drawable/dot_shape" />
        </LinearLayout>

        <!-- INPUT / CONTROLS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/inputText"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="Message Jarvis..."
                android:textColor="#F1F5F7"
                android:textColorHint="#78858F"
                android:textSize="14sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:imeOptions="actionSend" />

            <ImageButton android:id="@+id/micButton" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="6dp" android:background="@drawable/bg_mic_button" android:src="@android:drawable/ic_btn_speak_now" android:contentDescription="Voice" android:padding="10dp" app:tint="#E4EDF2" />
            <ImageButton android:id="@+id/sendButton" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="6dp" android:background="@drawable/bg_send_button" android:src="@drawable/ic_send" android:contentDescription="Send" android:padding="10dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:gravity="center"
            android:text="JARVIS can make mistakes. Please check important information."
            android:textColor="#66747E"
            android:textSize="7sp"
            android:paddingTop="1dp" />
    </LinearLayout>

    <!-- HISTORY PANEL -->
    <LinearLayout
        android:id="@+id/historyPanel"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="#11151A"
        android:elevation="20dp"
        android:visibility="gone">

        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Chats" android:textColor="#F1F5F7" android:textSize="21sp" android:fontFamily="sans-serif-medium" />
            <ImageButton android:id="@+id/closeHistoryButton" android:layout_width="42dp" android:layout_height="42dp" android:background="@android:color/transparent" android:src="@android:drawable/ic_menu_close_clear_cancel" android:contentDescription="Close" android:padding="10dp" app:tint="#B7C2C9" />
        </LinearLayout>

        <TextView android:id="@+id/newChatButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:gravity="center_vertical" android:paddingStart="17dp" android:text="+   New chat" android:textColor="#EFF4F7" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:background="@drawable/bg_input" android:clickable="true" android:focusable="true" />

        <EditText android:id="@+id/historySearch" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="14dp" android:background="@drawable/bg_input" android:hint="Search chats..." android:textColor="#F1F5F7" android:textColorHint="#737F88" android:textSize="13sp" android:paddingStart="14dp" android:paddingEnd="14dp" android:singleLine="true" android:imeOptions="actionSearch" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:layout_marginBottom="10dp" android:text="Recent" android:textColor="#73818A" android:textSize="11sp" android:fontFamily="sans-serif-medium" />

        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none">
            <LinearLayout android:id="@+id/historyList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

</FrameLayout>
