<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0F">

    <!-- Main screen -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <!-- TOP BAR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/historyButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_recent_history"
                android:contentDescription="Chat history"
                app:tint="#E7E7EC"
                android:padding="9dp"/>

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="9dp"
                android:src="@drawable/jarvis_logo"
                android:contentDescription="Jarvis"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/conversationTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New chat"
                    android:textColor="#F4F4F6"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"/>

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Online"
                    android:textColor="#777780"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

        </LinearLayout>


        <!-- CHAT AREA (holds either the empty-state greeting or the scrolling chat) -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- EMPTY STATE -->
            <LinearLayout
                android:id="@+id/emptyStateContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="What's on your mind today?"
                    android:textColor="#F0F0F0"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:layout_marginBottom="24dp"/>

                <TextView
                    android:id="@+id/suggestion1"
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:text="Explain something to me"
                    android:textColor="#D0D0D5"
                    android:textSize="13sp"
                    android:padding="14dp"
                    android:gravity="center"
                    android:background="@drawable/bg_input"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/suggestion2"
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:text="Give me some ideas"
                    android:textColor="#D0D0D5"
                    android:textSize="13sp"
                    android:padding="14dp"
                    android:gravity="center"
                    android:background="@drawable/bg_input"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/suggestion3"
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:text="Tell me something interesting"
                    android:textColor="#D0D0D5"
                    android:textSize="13sp"
                    android:padding="14dp"
                    android:gravity="center"
                    android:background="@drawable/bg_input"
                    android:clickable="true"
                    android:focusable="true"/>

            </LinearLayout>

            <!-- CHAT -->
            <ScrollView
                android:id="@+id/chatScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/chatContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"/>

            </ScrollView>

        </FrameLayout>


        <!-- THINKING -->

        <LinearLayout
            android:id="@+id/thinkingDots"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:visibility="gone">

            <View
                android:id="@+id/dot1"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/dot_shape"/>

            <View
                android:id="@+id/dot2"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/dot_shape"/>

            <View
                android:id="@+id/dot3"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/dot_shape"/>

        </LinearLayout>


        <!-- INPUT AREA -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/inputText"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="Message Jarvis..."
                android:textColor="#F5F5F7"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:paddingStart="17dp"
                android:paddingEnd="17dp"
                android:singleLine="true"
                android:imeOptions="actionSend"/>

            <ImageButton
                android:id="@+id/micButton"
                android:layout_width="43dp"
                android:layout_height="43dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_mic_button"
                android:src="@android:drawable/ic_btn_speak_now"
                android:contentDescription="Voice"
                android:padding="10dp"
                app:tint="#E5E5E9"/>

            <ImageButton
                android:id="@+id/sendButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_send_button"
                android:src="@drawable/ic_send"
                android:contentDescription="Send"
                android:padding="11dp"/>

        </LinearLayout>

    </LinearLayout>


    <!-- HISTORY PANEL -->

    <LinearLayout
        android:id="@+id/historyPanel"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="#111115"
        android:elevation="20dp"
        android:visibility="gone">

        <!-- History header -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chats"
                android:textColor="#F5F5F7"
                android:textSize="21sp"
                android:fontFamily="sans-serif-medium"/>

            <ImageButton
                android:id="@+id/closeHistoryButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Close"
                android:padding="10dp"
                app:tint="#B7B7BF"/>

        </LinearLayout>

        <!-- New chat -->

        <TextView
            android:id="@+id/newChatButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:paddingStart="17dp"
            android:text="+   New chat"
            android:textColor="#F2F2F5"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_input"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="10dp"
            android:text="Recent"
            android:textColor="#777780"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/historyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </ScrollView>

    </LinearLayout>

</FrameLayout>