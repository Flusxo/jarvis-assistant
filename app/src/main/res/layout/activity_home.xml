<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08080C">

    <!-- Main content -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <!-- Jarvis logo -->

        <ImageView
            android:layout_width="105dp"
            android:layout_height="105dp"
            android:src="@drawable/jarvis_logo"
            android:contentDescription="Jarvis logo"
            android:layout_marginBottom="28dp"/>


        <!-- Small welcome text -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WELCOME"
            android:textColor="#777780"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.25"
            android:layout_marginBottom="8dp"/>


        <!-- Main title -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JARVIS"
            android:textColor="#F5F5F7"
            android:textSize="38sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:gravity="center"/>


        <!-- Subtitle -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your personal AI assistant"
            android:textColor="#888890"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:layout_marginTop="8dp"
            android:gravity="center"/>


        <!-- Status -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="26dp">

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/dot_shape"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Systems online"
                android:textColor="#777780"
                android:textSize="12sp"/>

        </LinearLayout>


        <!-- Start button -->

        <TextView
            android:id="@+id/startJarvisButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="42dp"
            android:gravity="center"
            android:text="START JARVIS   →"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:background="@drawable/bg_start_button"
            android:clickable="true"
            android:focusable="true"/>


        <!-- Bottom hint -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chat  •  Voice  •  Camera"
            android:textColor="#55555D"
            android:textSize="11sp"
            android:layout_marginTop="18dp"/>

    </LinearLayout>

</FrameLayout>